#!/bin/bash

# Load shared configuration and functions
source "$(dirname "$0")/../../../shared"

run_container() {
    IMAGE=$(choose "What image to use?" "parrotsec/security" "kalilinux/kali-rolling") || return
    MOUNT=$(input "What mount path to use?" "/pwnbox") || return

    if [ "$IMAGE" = "kalilinux/kali-rolling" ]; then
        print_warning "Please note, there are no tools by default. Instead, either do:"
        print_info "apt update && apt -y install <package>"
        print_info "apt update && apt -y install kali-linux-headless"
        print_info "apt update && apt -y install kali-linux-large"
    fi

    print_command "docker run --rm -ti --network host -v $PWD:$MOUNT $IMAGE"

    operation \
        "Running container..." "docker run --rm -ti --network host -v $PWD:$MOUNT $IMAGE"
}

main_menu() {
    while true; do
        print_header "DOCKER"
        
        local OPTIONS=(
            "Run Container"
            "Exit"
        )
        
        local CHOICE=$(choose "Select an operation:" "${OPTIONS[@]}")
        
        case "$CHOICE" in
            *"Run Container"*) run_container ;;
            *"Exit"*|"")
                print_header "DOCKER"
                echo -e "${COLOR_SUCCESS}$(get_random_exit_message)${RESET}"
                echo ""
                exit 0
                ;;
        esac
    done
}

# Main execution (only when script is run directly, not sourced)
if [ "${BASH_SOURCE[0]}" == "${0}" ]; then
    check_deps "docker"
    setup_directory "docker"
    check_service "docker"
    check_group "docker"
    main_menu
fi