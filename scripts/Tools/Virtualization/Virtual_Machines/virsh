create_nat_network() {
    SUDO=$(sudo_prompt)

    NET_NAME=$(input "What network name to use?" "nat") || return
    NET_IP=$(input "What router IP to use?" "172.16.1.1") || return
    NET_MASK=$(input "What subnet mask to use?" "255.255.255.0") || return
    NET_DHCP_START=$(input "What DHCP start address to use?" "172.16.1.10") || return
    NET_DHCP_END=$(input "What DHCP end address to use?" "172.16.1.100") || return

    print_command "virsh net-define"

    operation \
        "Creating Network..." "$SUDO virsh net-define /dev/stdin <<EOF
        <network>
            <name>$NET_NAME</name>
            <forward mode='nat'/>
            <bridge name='virbr-$NET_NAME'/>
            <ip address='$NET_IP' netmask='$NET_MASK'>
                <dhcp>
                    <range start='$NET_DHCP_START' end='$NET_DHCP_END'/>
                </dhcp>
            </ip>
        </network>
EOF"

    print_info "Configuring Network start-up parameters."
    print_command "virsh net-autostart default" "virsh net-start $NET_NAME"
    operation \
        "Enabling Network autostart..." "$SUDO virsh net-autostart $NET_NAME" \
        "Starting Network..." "$SUDO virsh net-start $NET_NAME"

    print_info "Configuring Firewall to allow forwarding for virbr-$NET_NAME interface."
    print_command "sudo iptables -I FORWARD -i 'virbr-$NET_NAME' -j ACCEPT" "sudo iptables -I FORWARD -o 'virbr-$NET_NAME' -j ACCEPT"
    operation \
        "Adding 'Allow traffic FROM VMs' rule..." "sudo iptables -I FORWARD -i 'virbr-$NET_NAME' -j ACCEPT" \
        "Adding 'Allow traffic TO VMs' rule..." "sudo iptables -I FORWARD -o 'virbr-$NET_NAME' -j ACCEPT" \
        "Saving current iptables rules..." "sudo iptables-save | sudo tee /etc/sysconfig/iptables > /dev/null"
}

