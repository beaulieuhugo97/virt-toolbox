#!/bin/bash

# Load shared configuration and functions
source "$(dirname "$0")/../../../shared"

DEFAULT_VM_NAME="pwnbox"
DEFAULT_NET_NAME="default"

download_file() {
    print_info "Select an image to download:"

    local OPTIONS=(
        "Download ParrotOS Security Edition (ISO)"
        "Download ParrotOS HTB Edition (ISO)"
        "Download Kali Linux (ISO)"
        "Download Kali Linux (qcow2)"
        "Windows 11 (Manual - Instructions)"
        "Enter custom URL"
    )

    local CHOICE=$(choose "Select an operation:" "${OPTIONS[@]}")

    case "$CHOICE" in
        *"ParrotOS Security"*)
            FILE_URL="https://deb.parrot.sh/parrot/iso/6.4/Parrot-security-6.4_amd64.iso"
            ;;    
        *"ParrotOS HTB"*)
            FILE_URL="https://deb.parrot.sh/parrot/iso/6.4/Parrot-htb-6.4_amd64.iso"
            ;;
        *"Kali Linux (ISO)"*)
            FILE_URL="https://cdimage.kali.org/kali-2025.3/kali-linux-2025.3-installer-amd64.iso"
            ;;
        *"Kali Linux (qcow2)"*)
            FILE_URL="https://mirror.quantum5.ca/kali-images/kali-2025.2/kali-linux-2025.2-qemu-amd64.7z"
            ;;
        *"Windows 11 (Manual - Instructions)"*)
            print_info "Windows 11 ISO Manual Download Instructions:"
            echo ""
            echo "1. Visit: https://www.microsoft.com/software-download/windows11"
            echo "2. Click 'Download Windows 11 Disk Image (ISO)'"
            echo "3. Select your edition and language"
            echo "4. Download the ISO file"
            echo "5. Move the ISO to: /var/lib/libvirt/images/"
            echo "   Example: sudo mv ~/Downloads/*.iso /var/lib/libvirt/images/"
            echo "6. Use 'Create VM from ISO' option with the file path"
            echo ""
            print_info "VirtIO drivers (recommended for Windows VMs):"
            echo "   VirtIO ISO: https://fedorapeople.org/groups/virt/virtio-win/direct-downloads/stable-virtio/virtio-win.iso"
            echo "   VirtIO GTK: sudo dnf install spice-gtk-tools"
            echo "   Save to: /var/lib/libvirt/images/"
            echo ""
            print_info "MS Build Tools (for compiling Windows projects):"
            echo "   After Windows VM is set up, download and install:"
            echo "   - VS 2015: https://aka.ms/vs/14/release/vs_buildtools.exe"
            echo "   - VS 2017: https://aka.ms/vs/15/release/vs_buildtools.exe"
            echo "   - VS 2019: https://aka.ms/vs/16/release/vs_buildtools.exe"
            echo "   - VS 2022: https://aka.ms/vs/17/release/vs_buildtools.exe"
            echo ""
            echo "   Usage: Open 'Developer PowerShell' and run:"
            echo "      msbuild CVE-POC.sln /p:Configuration=Release /p:Platform=x64"
            echo ""
            pause
            return 0
            ;;
        *"Enter custom URL"*)
            FILE_URL=$(input "What file URL to download?" "https://cdimage.debian.org/debian-cd/current/amd64/iso-cd/debian-13.1.0-amd64-netinst.iso") || return
            ;;
        *)
            print_error "No selection made"
            pause
            return 1
            ;;
    esac

    print_info "Selected URL: $FILE_URL"

    # Extract filename from URL
    FILENAME=$(basename "$FILE_URL")

    # Detect file extension and type
    if [[ $FILENAME == *.tar.gz ]]; then
        FILE_TYPE="tar.gz"
    elif [[ $FILENAME == *.tar.bz2 ]]; then
        FILE_TYPE="tar.bz2"
    elif [[ $FILENAME == *.tar.xz ]]; then
        FILE_TYPE="tar.xz"
    elif [[ $FILENAME == *.tar.* ]]; then
        FILE_TYPE="tar"
    elif [[ $FILENAME == *.7z ]]; then
        FILE_TYPE="7z"
    elif [[ $FILENAME == *.zip ]]; then
        FILE_TYPE="zip"
    elif [[ $FILENAME == *.rar ]]; then
        FILE_TYPE="rar"
    elif [[ $FILENAME == *.iso ]]; then
        FILE_TYPE="iso"
    elif [[ $FILENAME == *.qcow2 ]]; then
        FILE_TYPE="qcow2"
    else
        print_error "Unsupported file type: $FILENAME"
        pause
        return 1
    fi

    print_info "Detected file type: $FILE_TYPE"

    # Check for existing files
    SKIP_DOWNLOAD=false
    SKIP_EXTRACTION=false

    # For archive types, check for extracted files first
    if [[ "$FILE_TYPE" == "7z" || "$FILE_TYPE" == "zip" || "$FILE_TYPE" == "tar.gz" || "$FILE_TYPE" == "tar.bz2" || "$FILE_TYPE" == "tar.xz" || "$FILE_TYPE" == "tar" || "$FILE_TYPE" == "rar" ]]; then
        # Check for extracted qcow2 or iso files
        EXTRACTED_FILES=$(find . -maxdepth 1 -type f \( -name "*.qcow2" -o -name "*.iso" \) 2>/dev/null)

        if [ -n "$EXTRACTED_FILES" ]; then
            print_warning "Extracted files found:"
            echo ""
            while IFS= read -r file; do
                FILE_SIZE_HUMAN=$(du -h "$file" | cut -f1)
                FILE_SIZE_BYTES=$(stat -c%s "$file")
                echo "  $(basename "$file"): $FILE_SIZE_HUMAN ($FILE_SIZE_BYTES bytes)"
            done <<< "$EXTRACTED_FILES"
            echo ""

            local FILE_OPTIONS=(
                "Delete all and redownload"
                "Use existing files (skip download & extraction)"
                "Cancel operation"
            )

            local FILE_CHOICE=$(choose "What would you like to do?" "${FILE_OPTIONS[@]}")

            case "$FILE_CHOICE" in
                *"Delete all and redownload"*)
                    print_info "Deleting existing files..."
                    rm -f *.qcow2 *.iso "$FILENAME" 2>/dev/null
                    ;;
                *"Use existing files"*)
                    print_info "Using existing files, skipping download and extraction..."
                    SKIP_DOWNLOAD=true
                    SKIP_EXTRACTION=true
                    ;;
                *"Cancel operation"*|*)
                    print_info "Operation cancelled"
                    pause
                    return 0
                    ;;
            esac
        # If no extracted files, check for archive file
        elif [ -f "$FILENAME" ]; then
            FILE_SIZE_HUMAN=$(du -h "$FILENAME" | cut -f1)
            FILE_SIZE_BYTES=$(stat -c%s "$FILENAME")

            print_warning "Archive file already exists: $FILENAME"
            echo "  Size: $FILE_SIZE_HUMAN ($FILE_SIZE_BYTES bytes)"
            echo ""

            local FILE_OPTIONS=(
                "Delete and redownload"
                "Use existing archive (skip download, extract only)"
                "Cancel operation"
            )

            local FILE_CHOICE=$(choose "What would you like to do?" "${FILE_OPTIONS[@]}")

            case "$FILE_CHOICE" in
                *"Delete and redownload"*)
                    print_info "Deleting existing archive..."
                    rm -f "$FILENAME"
                    ;;
                *"Use existing archive"*)
                    print_info "Using existing archive, skipping download..."
                    SKIP_DOWNLOAD=true
                    ;;
                *"Cancel operation"*|*)
                    print_info "Operation cancelled"
                    pause
                    return 0
                    ;;
            esac
        fi
    # For non-archive types (iso, qcow2), check directly
    elif [ -f "$FILENAME" ]; then
        FILE_SIZE_HUMAN=$(du -h "$FILENAME" | cut -f1)
        FILE_SIZE_BYTES=$(stat -c%s "$FILENAME")

        print_warning "File already exists: $FILENAME"
        echo "  Size: $FILE_SIZE_HUMAN ($FILE_SIZE_BYTES bytes)"
        echo ""

        local FILE_OPTIONS=(
            "Delete and redownload"
            "Use existing file (skip download)"
            "Cancel operation"
        )

        local FILE_CHOICE=$(choose "What would you like to do?" "${FILE_OPTIONS[@]}")

        case "$FILE_CHOICE" in
            *"Delete and redownload"*)
                print_info "Deleting existing file..."
                rm -f "$FILENAME"
                ;;
            *"Use existing file"*)
                print_info "Using existing file, skipping download..."
                SKIP_DOWNLOAD=true
                ;;
            *"Cancel operation"*|*)
                print_info "Operation cancelled"
                pause
                return 0
                ;;
        esac
    fi

    # Build operation commands based on file type
    case "$FILE_TYPE" in
        "7z")
            if [ "$SKIP_DOWNLOAD" = true ] && [ "$SKIP_EXTRACTION" = true ]; then
                print_command "chmod 644 *.qcow2 *.iso 2>/dev/null || true" "sudo mv *.qcow2 *.iso /var/lib/libvirt/images/"
                operation \
                    "Setting permissions..." "chmod 644 *.qcow2 *.iso 2>/dev/null || chmod 644 *" \
                    "Moving files to images directory..." "sudo mv *.qcow2 /var/lib/libvirt/images/ 2>/dev/null || sudo mv *.iso /var/lib/libvirt/images/ 2>/dev/null || true"
            elif [ "$SKIP_DOWNLOAD" = true ]; then
                print_command "7z x -y *.7z" "chmod 644 *.qcow2 *.iso 2>/dev/null || true" "sudo mv *.qcow2 *.iso /var/lib/libvirt/images/" "rm *.7z"
                operation \
                    "Extracting 7z archive..." "7z x -y *.7z" \
                    "Setting permissions..." "chmod 644 *.qcow2 *.iso 2>/dev/null || chmod 644 *" \
                    "Moving files to images directory..." "sudo mv *.qcow2 /var/lib/libvirt/images/ 2>/dev/null || sudo mv *.iso /var/lib/libvirt/images/ 2>/dev/null || true" \
                    "Removing archive..." "rm *.7z"
            else
                print_command "wget $FILE_URL" "7z x -y *.7z" "chmod 644 *.qcow2 *.iso 2>/dev/null || true" "sudo mv *.qcow2 *.iso /var/lib/libvirt/images/" "rm *.7z"
                operation \
                    "Downloading file..." "wget $FILE_URL" \
                    "Extracting 7z archive..." "7z x -y *.7z" \
                    "Setting permissions..." "chmod 644 *.qcow2 *.iso 2>/dev/null || chmod 644 *" \
                    "Moving files to images directory..." "sudo mv *.qcow2 /var/lib/libvirt/images/ 2>/dev/null || sudo mv *.iso /var/lib/libvirt/images/ 2>/dev/null || true" \
                    "Removing archive..." "rm *.7z"
            fi
            ;;
        "zip")
            if [ "$SKIP_DOWNLOAD" = true ] && [ "$SKIP_EXTRACTION" = true ]; then
                print_command "chmod 644 *.qcow2 *.iso 2>/dev/null || true" "sudo mv *.qcow2 *.iso /var/lib/libvirt/images/"
                operation \
                    "Setting permissions..." "chmod 644 *.qcow2 *.iso 2>/dev/null || chmod 644 *" \
                    "Moving files to images directory..." "sudo mv *.qcow2 /var/lib/libvirt/images/ 2>/dev/null || sudo mv *.iso /var/lib/libvirt/images/ 2>/dev/null || true"
            elif [ "$SKIP_DOWNLOAD" = true ]; then
                print_command "unzip *.zip" "chmod 644 *.qcow2 *.iso 2>/dev/null || true" "sudo mv *.qcow2 *.iso /var/lib/libvirt/images/" "rm *.zip"
                operation \
                    "Extracting zip archive..." "unzip *.zip" \
                    "Setting permissions..." "chmod 644 *.qcow2 *.iso 2>/dev/null || chmod 644 *" \
                    "Moving files to images directory..." "sudo mv *.qcow2 /var/lib/libvirt/images/ 2>/dev/null || sudo mv *.iso /var/lib/libvirt/images/ 2>/dev/null || true" \
                    "Removing archive..." "rm *.zip"
            else
                print_command "wget $FILE_URL" "unzip *.zip" "chmod 644 *.qcow2 *.iso 2>/dev/null || true" "sudo mv *.qcow2 *.iso /var/lib/libvirt/images/" "rm *.zip"
                operation \
                    "Downloading file..." "wget $FILE_URL" \
                    "Extracting zip archive..." "unzip *.zip" \
                    "Setting permissions..." "chmod 644 *.qcow2 *.iso 2>/dev/null || chmod 644 *" \
                    "Moving files to images directory..." "sudo mv *.qcow2 /var/lib/libvirt/images/ 2>/dev/null || sudo mv *.iso /var/lib/libvirt/images/ 2>/dev/null || true" \
                    "Removing archive..." "rm *.zip"
            fi
            ;;
        "tar.gz"|"tar.bz2"|"tar.xz"|"tar")
            if [ "$SKIP_DOWNLOAD" = true ] && [ "$SKIP_EXTRACTION" = true ]; then
                print_command "chmod 644 *.qcow2 *.iso 2>/dev/null || true" "sudo mv *.qcow2 *.iso /var/lib/libvirt/images/"
                operation \
                    "Setting permissions..." "chmod 644 *.qcow2 *.iso 2>/dev/null || chmod 644 *" \
                    "Moving files to images directory..." "sudo mv *.qcow2 /var/lib/libvirt/images/ 2>/dev/null || sudo mv *.iso /var/lib/libvirt/images/ 2>/dev/null || true"
            elif [ "$SKIP_DOWNLOAD" = true ]; then
                print_command "tar xf *.tar.*" "chmod 644 *.qcow2 *.iso 2>/dev/null || true" "sudo mv *.qcow2 *.iso /var/lib/libvirt/images/" "rm *.tar.*"
                operation \
                    "Extracting tar archive..." "tar xf *.tar.*" \
                    "Setting permissions..." "chmod 644 *.qcow2 *.iso 2>/dev/null || chmod 644 *" \
                    "Moving files to images directory..." "sudo mv *.qcow2 /var/lib/libvirt/images/ 2>/dev/null || sudo mv *.iso /var/lib/libvirt/images/ 2>/dev/null || true" \
                    "Removing archive..." "rm *.tar.*"
            else
                print_command "wget $FILE_URL" "tar xf *.tar.*" "chmod 644 *.qcow2 *.iso 2>/dev/null || true" "sudo mv *.qcow2 *.iso /var/lib/libvirt/images/" "rm *.tar.*"
                operation \
                    "Downloading file..." "wget $FILE_URL" \
                    "Extracting tar archive..." "tar xf *.tar.*" \
                    "Setting permissions..." "chmod 644 *.qcow2 *.iso 2>/dev/null || chmod 644 *" \
                    "Moving files to images directory..." "sudo mv *.qcow2 /var/lib/libvirt/images/ 2>/dev/null || sudo mv *.iso /var/lib/libvirt/images/ 2>/dev/null || true" \
                    "Removing archive..." "rm *.tar.*"
            fi
            ;;
        "rar")
            if [ "$SKIP_DOWNLOAD" = true ] && [ "$SKIP_EXTRACTION" = true ]; then
                print_command "chmod 644 *.qcow2 *.iso 2>/dev/null || true" "sudo mv *.qcow2 *.iso /var/lib/libvirt/images/"
                operation \
                    "Setting permissions..." "chmod 644 *.qcow2 *.iso 2>/dev/null || chmod 644 *" \
                    "Moving files to images directory..." "sudo mv *.qcow2 /var/lib/libvirt/images/ 2>/dev/null || sudo mv *.iso /var/lib/libvirt/images/ 2>/dev/null || true"
            elif [ "$SKIP_DOWNLOAD" = true ]; then
                print_command "unrar x *.rar" "chmod 644 *.qcow2 *.iso 2>/dev/null || true" "sudo mv *.qcow2 *.iso /var/lib/libvirt/images/" "rm *.rar"
                operation \
                    "Extracting rar archive..." "unrar x *.rar" \
                    "Setting permissions..." "chmod 644 *.qcow2 *.iso 2>/dev/null || chmod 644 *" \
                    "Moving files to images directory..." "sudo mv *.qcow2 /var/lib/libvirt/images/ 2>/dev/null || sudo mv *.iso /var/lib/libvirt/images/ 2>/dev/null || true" \
                    "Removing archive..." "rm *.rar"
            else
                print_command "wget $FILE_URL" "unrar x *.rar" "chmod 644 *.qcow2 *.iso 2>/dev/null || true" "sudo mv *.qcow2 *.iso /var/lib/libvirt/images/" "rm *.rar"
                operation \
                    "Downloading file..." "wget $FILE_URL" \
                    "Extracting rar archive..." "unrar x *.rar" \
                    "Setting permissions..." "chmod 644 *.qcow2 *.iso 2>/dev/null || chmod 644 *" \
                    "Moving files to images directory..." "sudo mv *.qcow2 /var/lib/libvirt/images/ 2>/dev/null || sudo mv *.iso /var/lib/libvirt/images/ 2>/dev/null || true" \
                    "Removing archive..." "rm *.rar"
            fi
            ;;
        "iso"|"qcow2")
            if [ "$SKIP_DOWNLOAD" = true ]; then
                print_command "chmod 644 $FILENAME" "sudo mv $FILENAME /var/lib/libvirt/images/"
                operation \
                    "Setting permissions..." "chmod 644 $FILENAME" \
                    "Moving file to images directory..." "sudo mv $FILENAME /var/lib/libvirt/images/"
            else
                print_command "wget $FILE_URL" "chmod 644 $FILENAME" "sudo mv $FILENAME /var/lib/libvirt/images/"
                operation \
                    "Downloading file..." "wget $FILE_URL" \
                    "Setting permissions..." "chmod 644 $FILENAME" \
                    "Moving file to images directory..." "sudo mv $FILENAME /var/lib/libvirt/images/"
            fi
            ;;
    esac
}

import_vm() {
    SUDO=$(sudo_prompt)

    print_info "Enter Virtual Machine details."

    VM_NAME=$(input "What VM name to use?" "$DEFAULT_VM_NAME") || return
    pause "Press [Enter] to select the qcow2 disk..."
    VM_DISK=$(file_browser "/var/lib/libvirt/images/")
    VM_TYPE=$(choose "What OS type to use?" "debian11" "win11") || return
    VM_CPU=$(input "What number of vCPUs to use?" "6") || return
    VM_RAM=$(input "What RAM in MB to use?" "8192") || return
    VM_NET=$(input "What network interface to use?" "virbr0") || return

    print_command "$SUDO virt-install --os-variant $VM_TYPE --name $VM_NAME --ram $VM_RAM --vcpus $VM_CPU --cpu host --disk path=$VM_DISK,bus=virtio,cache=writeback --network bridge=$VM_NET,model=virtio --graphics spice,listen=0.0.0.0 --video qxl --channel spicevmc,target_type=virtio,name=com.redhat.spice.0 --console pty,target_type=serial --import"

    operation \
        "Importing Virtual Machine..." "$SUDO virt-install --os-variant $VM_TYPE --name $VM_NAME --ram $VM_RAM --vcpus $VM_CPU --cpu host --disk path=$VM_DISK,bus=virtio,cache=writeback --network bridge=$VM_NET,model=virtio --graphics spice,listen=0.0.0.0 --video qxl --channel spicevmc,target_type=virtio,name=com.redhat.spice.0 --console pty,target_type=serial --import"
}

create_vm() {
    SUDO=$(sudo_prompt)

    print_info "Enter Virtual Machine details."

    VM_NAME=$(input "What VM name to use?" "$DEFAULT_VM_NAME") || return
    pause "Press [Enter] to select the ISO file..."
    VM_ISO=$(file_browser "/var/lib/libvirt/images/")
    VM_TYPE=$(choose "What OS type to use?" "debian11" "win11") || return
    VM_CPU=$(input "What number of vCPUs to use?" "8") || return
    VM_RAM=$(input "What RAM in MB to use?" "16384") || return
    VM_DISK_SIZE=$(input "What disk size in GB to use?" "64") || return
    VM_DISK_PATH=$(input "What disk path to use?" "/var/lib/libvirt/images/${VM_NAME}.qcow2") || return
    VM_NET=$(input "What network interface to use?" "virbr0") || return

    # Build base virt-install command
    VIRT_INSTALL_CMD="$SUDO virt-install --os-variant $VM_TYPE --name $VM_NAME --ram $VM_RAM --vcpus $VM_CPU --cpu host --cdrom $VM_ISO --disk path=$VM_DISK_PATH,size=$VM_DISK_SIZE,bus=virtio,cache=writeback,format=qcow2 --network bridge=$VM_NET,model=virtio --graphics spice,listen=0.0.0.0 --video qxl --channel spicevmc,target_type=virtio,name=com.redhat.spice.0 --console pty,target_type=serial"

    # Check if this is a Windows VM (win in the OS type)
    if [[ $VM_TYPE == *"win"* ]]; then
        print_info "Windows VM detected. You may need VirtIO drivers for optimal performance."
        USE_VIRTIO=$(input "Add VirtIO drivers ISO? (y/n)" "n") || return

        if [[ $USE_VIRTIO == "y" || $USE_VIRTIO == "Y" ]]; then
            VIRTIO_ISO=$(input "What VirtIO ISO path to use?" "/var/lib/libvirt/images/virtio-win.iso") || return
            VIRT_INSTALL_CMD="$VIRT_INSTALL_CMD --disk path=$VIRTIO_ISO,device=cdrom"
        fi
    fi

    print_command "$VIRT_INSTALL_CMD"

    operation \
        "Creating Virtual Machine..." "$VIRT_INSTALL_CMD"
}

