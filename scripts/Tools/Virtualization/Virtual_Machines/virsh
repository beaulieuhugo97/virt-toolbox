manage_ip_forwarding() {
    SUDO=$(sudo_prompt)

    NET_NAME=$(input "What network name to configure?" "nat") || return

    print_info "Select IP forwarding action:"

    local OPTIONS=(
        "Enable IP Forwarding"
        "Disable IP Forwarding"
    )

    local CHOICE=$(choose "Select an operation:" "${OPTIONS[@]}")

    case "$CHOICE" in
        *"Enable"*)
            print_command "sudo iptables -I FORWARD -i 'virbr-$NET_NAME' -j ACCEPT" "sudo iptables -I FORWARD -o 'virbr-$NET_NAME' -j ACCEPT"

            operation \
                "Adding 'Allow traffic FROM VMs' rule..." "sudo iptables -I FORWARD -i 'virbr-$NET_NAME' -j ACCEPT" \
                "Adding 'Allow traffic TO VMs' rule..." "sudo iptables -I FORWARD -o 'virbr-$NET_NAME' -j ACCEPT" \
                "Saving current iptables rules..." "sudo iptables-save | sudo tee /etc/sysconfig/iptables > /dev/null"
            ;;
        *"Disable"*)
            print_command "sudo iptables -D FORWARD -i 'virbr-$NET_NAME' -j ACCEPT" "sudo iptables -D FORWARD -o 'virbr-$NET_NAME' -j ACCEPT"

            operation \
                "Removing 'Allow traffic FROM VMs' rule..." "sudo iptables -D FORWARD -i 'virbr-$NET_NAME' -j ACCEPT" \
                "Removing 'Allow traffic TO VMs' rule..." "sudo iptables -D FORWARD -o 'virbr-$NET_NAME' -j ACCEPT" \
                "Saving current iptables rules..." "sudo iptables-save | sudo tee /etc/sysconfig/iptables > /dev/null"
            ;;
        *)
            print_error "No selection made"
            pause
            return 1
            ;;
    esac
}

