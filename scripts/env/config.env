# Local
LIP="10.10.10.10"
LPORT="1337"
LOCAL_CONFIG_MENU=(
    "Local"
    "Local IP Address" "LIP" "network_interface" "required" ""
    "Local Port" "LPORT" "port" "port" ""    
)

# Remote
RIP="10.100.100.100"
RPORT="80"
RHOST="box.htb"
RUSER="user.name"
RPASSWORD="Pa5%W0rD"
REMOTE_CONFIG_MENU=(
    "Remote"
    "Remote Host" "RHOST" "text" "required" ""
    "Remote IP Address" "RIP" "text" "required" ""
    "Remote Port" "RPORT" "text" "required" ""
    "Remote Username" "RUSER" "text" "required" ""
    "Remote Password" "RPASSWORD" "password" "required" ""    
)

# Wordlists
WORDLISTS_DIR="$HOME/.pentest-toolbox/wordlists"
PASS_WORDLIST_FILE="$HOME/.pentest-toolbox/wordlists/rockyou.txt"
USER_WORDLIST_FILE="$HOME/.pentest-toolbox/wordlists/windows-usernames-wordlist.txt"
DIR_WORDLIST="$HOME/.pentest-toolbox/wordlists/discovery-wordlist.txt"
SUBDOM_WORDLIST="$HOME/.pentest-toolbox/wordlists/subdomain-wordlist.txt"
WORDLISTS_CONFIG_MENU=(
    "Wordlists"
    "Password Wordlist" "PASS_WORDLIST_FILE" "wordlist" "optional" ""
    "Username Wordlist" "USER_WORDLIST_FILE" "wordlist" "optional" ""
    "Directory Wordlist" "DIR_WORDLIST" "wordlist" "optional" ""
    "Subdomain Wordlist" "SUBDOM_WORDLIST" "wordlist" "optional" ""
)

# Active Directory
DOMAIN="$RHOST"
DC_IP="$RIP"
AD_CONFIG_MENU=(
    "Active Directory"
    "Domain Name" "DOMAIN" "text" "required" ""
    "Domain Controller IP" "DC_IP" "text" "required" ""
)