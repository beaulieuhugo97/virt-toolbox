# Libvirt
# Mirrors extension/src/config/configMenus.ts — keep the two in step.
LIBVIRT_URI="qemu:///system"
IMAGES_DIR="/var/lib/libvirt/images"
DEFAULT_NET="virbr0"
LIBVIRT_CONFIG_MENU=(
    "Libvirt"
    "Connection URI" "LIBVIRT_URI" "text" "required" ""
    "Images Directory" "IMAGES_DIR" "path" "required" ""
    "Default Network" "DEFAULT_NET" "text" "required" ""
)
