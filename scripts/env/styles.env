# New color palette (hex values for gum commands)
TEXT="#c5d1eb"
TEXT_DIM="#a4b1cd"
PRIMARY="#9fef00"
SUCCESS="#2e6cff"
ERROR="#ff3e3e"
WARN="#ffaf00"
INFO="#9f00ff"
DEBUG="#2ee7b6"

# ANSI color codes (for echo commands)
# Using true color (24-bit) ANSI codes for exact color matching
COLOR_TEXT='\033[38;2;197;209;235m'        # #c5d1eb
COLOR_TEXT_DIM='\033[38;2;164;177;205m'    # #a4b1cd
COLOR_PRIMARY='\033[38;2;159;239;0m'       # #9fef00
COLOR_SUCCESS='\033[38;2;46;108;255m'         # #2e6cff
COLOR_ERROR='\033[38;2;255;62;62m'         # #ff3e3e
COLOR_WARN='\033[38;2;255;175;0m'          # #ffaf00
COLOR_INFO='\033[38;2;159;0;255m'         # #9f00ff
COLOR_DEBUG='\033[38;2;46;231;182m'         # #2ee7b6

# Style codes
BOLD='\033[1m'
DIM='\033[2m'
RESET='\033[0m'

# Gum Environment Variables for consistent styling
# These environment variables configure gum commands globally

# Gum Style (for headers, boxes, etc.)
export GUM_STYLE_FOREGROUND="$PRIMARY"
export GUM_STYLE_BORDER_FOREGROUND="$PRIMARY"
export GUM_STYLE_BORDER="double"
export GUM_STYLE_ALIGN="center"

# Gum Input (for text input)
export GUM_INPUT_PROMPT_FOREGROUND="$PRIMARY"
export GUM_INPUT_CURSOR_FOREGROUND="$PRIMARY"
export GUM_INPUT_CHAR_LIMIT="0"

# Gum Choose (for menu selection)
export GUM_CHOOSE_HEADER_FOREGROUND="$PRIMARY"
export GUM_CHOOSE_CURSOR_FOREGROUND="$PRIMARY"
export GUM_CHOOSE_SELECTED_FOREGROUND="$PRIMARY"
export GUM_CHOOSE_CURSOR=" > "

# Gum Confirm (for yes/no prompts)
export GUM_CONFIRM_PROMPT_FOREGROUND="$PRIMARY"
export GUM_CONFIRM_SELECTED_FOREGROUND="$TEXT"
export GUM_CONFIRM_SELECTED_BACKGROUND="$PRIMARY"
export GUM_CONFIRM_UNSELECTED_FOREGROUND="$TEXT_DIM"

# Gum Spin (for loading spinners)
export GUM_SPIN_SPINNER="dot"
export GUM_SPIN_SHOW_OUTPUT="true"

export FZF_DEFAULT_OPTS=$FZF_DEFAULT_OPTS'
  --color=fg:#9fef00,fg+:#c5d1eb,bg:#1a2332,bg+:#141d2b
  --color=hl:#c5d1eb,hl+:#2e6cff,info:#a4b1cd,marker:#87ff00
  --color=prompt:#9fef00,spinner:#9fef00,pointer:#9fef00,header:#a4b1cd
  --color=border:#9fef00,label:#aeaeae,query:#c5d1eb'

# Exit Messages
EXIT_MSG=("Bye!" "Goodbye!" "Catch you later!" "See ya!")