#!/bin/bash

# Source required files
source "$(dirname "${BASH_SOURCE[0]}")/env/styles.env"
source "$(dirname "${BASH_SOURCE[0]}")/env/config.env"


pause() {
    TEXT="Press Enter to continue..."

    if [ "$1" ]; then
        TEXT="$1"
    fi

    echo ""
    echo -e "${DIM}$TEXT${RESET}"
    read
}

print_success() {
    gum style --foreground "$SUCCESS" --bold "[SUCCESS] $1"
}

print_error() {
    gum style --foreground "$ERROR" --bold "[ERROR] $1"
}

print_warning() {
    gum style --foreground "$WARN" --bold "[WARN] $1"
}

print_info() {
    gum style --foreground "$INFO" "[INFO] $1"
}

print_divider() {
    echo -e "${DIM}${COLOR_TEXT}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
}

print_header() {
    clear
    gum style --foreground "$PRIMARY" --border-foreground "$PRIMARY" --border double --align center --width 24 --margin "1 2" --padding "0 0" "$1"
}

input() {
    echo "$1:" >&2 # Redirect the echo to stderr so the variable displays to the user but doesn't get captured
    gum input --placeholder "$1" --value "$2"
}

input_password() {
    echo "$1:" >&2 # Redirect the echo to stderr so the variable displays to the user but doesn't get captured
    gum input --password --placeholder "$1"
}

prompt() {
    gum confirm "$1"
}

sudo_prompt() {
    if gum confirm "Run with sudo?"; then
        echo "sudo"
    fi
}

sudo_auth() {
    local password
    password=$(input_password "Enter sudo password") || return 1
    echo "$password" | sudo -S -v 2>/dev/null || {
        print_error "Invalid password"
        pause
        return 1
    }
}

operation_prompt() {
    gum confirm "Execute this operation?"
}

print_command() {
    echo -e "${COLOR_INFO}Command to execute:${RESET}"

    while [[ $# -gt 0 ]]; do
        echo -e "${COLOR_TEXT}$1${RESET}"
        shift
    done
}

spinner() {
    gum spin --title "$1" -- bash -c "$2"
}

operation() {
    if operation_prompt; then
        while [[ $# -gt 1 ]]; do
            local description="$1"
            local command="$2"
            print_info "$description"
            bash -c "$command"
            shift 2
        done
        print_success "Operation completed."
    else
        print_info "Operation cancelled."
    fi
    pause    
}

setup_directory() {
    mkdir -p "outputs/$1"
    cd "outputs/$1"
}

check_deps() {
    print_info "Checking dependencies..."
    for dep in "$@"; do
        if ! command -v "$dep" &> /dev/null; then
            print_error "$dep is not installed."
            print_warning "Please install the required dependencies before continuing."
            exit 1
        else
            print_success "$dep found."
        fi
    done

    print_success "All dependencies checks completed successfully!"
    pause
}

check_rpm(){
    print_info "Checking rpm packages..."
    for dep in "$@"; do
        if rpm -q spice-gtk-tools | grep "is not installed"; then
            print_error "$dep is not installed."
            print_warning "Please install the required packages before continuing."
            exit 1
        else
            print_success "$dep found."
        fi
    done

    print_success "All packages checks completed successfully!"
    pause    
}

check_libs() {
    print_info "Checking librairies..."
    for lib in "$@"; do
        if ! dpkg -s $lib &>/dev/null; then
            print_error "$lib is not installed."
            print_warning "Please install the required libraries before continuing."
            exit 1
        else
            print_success "$lib found."
        fi
    done

    print_success "All dependencies checks completed successfully!"
    pause
}

check_service() {
    sudo_auth

    # Check if service is started
    print_info "Checking $1 service status..."
    if sudo systemctl status $1 | grep -q running; then
        print_success "$1 is already running"
    else
        print_warning "$1 is not running, starting it..."
        if sudo systemctl start $1; then
            print_success "$1 started successfully"
        else
            print_error "Failed to start $1 service"
            exit 1
        fi
    fi
}

check_group() {
    print_info "Checking user group membership..."
    if groups | grep -q "$1"; then
        print_success "User $(whoami) is in the $1 group."
    else
        print_warning "User $(whoami) is missing from the $1 group."
        print_info "Adding user $(whoami) to $1 group."
        sudo_auth
        sudo usermod -a -G $1 "$(whoami)"
        print_success "Added user to group.";
        pause "Press [Enter] to refresh shell."
        print_warning "Shell might close after refresh."
        print_info "Refreshing shell..."
        newgrp $1
    fi 
}

check_venv() {
    if [ ! -d "$1" ]; then
        print_error "$1 not found. Please install it first."
        echo ""
        echo -e "${DIM}Press Enter to continue...${RESET}"
        read
        exit 1
    fi
}

execute_with_venv() {
    PYTHON_VERSION="$1"
    CMD="$2"

    # Execute all commands in a single shell context to maintain virtual environment
    bash -c "
        set -e
        pyenv global '$PYTHON_VERSION'
        source $CMD-venv/bin/activate
        $CMD
        exit_code=\$?
        pyenv global system
        exit \$exit_code
    "
    return $?
}

choose() {
    local header="$1"
    shift
    printf '%s\n' "$@" | gum choose --header "$header"
}

get_random_exit_message() {
    local random_index=$((RANDOM % ${#EXIT_MSG[@]}))
    echo "${EXIT_MSG[$random_index]}"
}

file_browser() {
    local current_dir="$1"

    sudo_auth

    while true; do
        local result key selection

        # List current directory contents, add parent indicator, exclude hidden files
        # Add trailing slash to directories for visual distinction
        result=$(
            export CURRENT_DIR="$current_dir"
            (echo ".." && sudo find "$current_dir" -maxdepth 1 -mindepth 1 -not -name '.*' 2>/dev/null | while read -r item; do
                if [ -d "$item" ]; then
                    echo "$(basename "$item")/"
                else
                    basename "$item"
                fi
            done | sort) | \
            fzf --prompt="$current_dir> " \
                --expect=space,esc \
                --preview 'item={}; item=${item%/}; if [ "$item" = ".." ]; then ls -lh "$(dirname "$CURRENT_DIR")"; elif [ -d "$CURRENT_DIR/$item" ]; then ls -lh "$CURRENT_DIR/$item"; elif [ -f "$CURRENT_DIR/$item" ]; then head -n 50 "$CURRENT_DIR/$item"; fi' \
                --preview-window=right:50% \
                --bind 'ctrl-/:change-preview-window(down|hidden|)' \
                --header '[Enter]: select file/navigate directory | [Space]: select current directory | [Esc]: cancel'
        )
        
        # Extract key pressed and selection
        key=$(echo "$result" | head -1)
        selection=$(echo "$result" | tail -n +2)

        # Remove trailing slash if present (for directory navigation)
        selection_clean="${selection%/}"

        # Handle user action
        case "$key" in
            esc)
                # User cancelled
                return 1
                ;;
            space)
                # Select current directory
                echo "$current_dir"
                return 0
                ;;
            "")
                # Enter pressed
                if [[ -z "$selection" ]]; then
                    return 1
                elif [[ "$selection" == ".." ]]; then
                    # Go to parent directory
                    current_dir=$(dirname "$current_dir")
                elif [[ -d "$current_dir/$selection_clean" ]]; then
                    # Enter directory
                    current_dir="$current_dir/$selection_clean"
                else
                    # Select file
                    echo "$current_dir/$selection_clean"
                    return 0
                fi
                ;;
        esac
    done
}